# 复制为 .env 并修改（生产环境必须设置随机密钥：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-random-secret
DATA_DIR=/app/data
PORT=8080

# 使用阿里云 ACR 镜像部署时（GitHub Actions 自动构建），取消注释并填写实际地址：
# WEB_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/workbench-web:latest
# APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/workbench-app:latest

# 淘宝开放平台（阿里司法拍卖官方 API，免费、不需用户授权）
# 申请：https://open.taobao.com → 注册开发者并实名 → 创建应用 → 拿到 AppKey/AppSecret
# 配置后会自动启用「阿里法拍-住宅(官方API)」数据源；不配置则不会注册该源
# TAOBAO_APP_KEY=
# TAOBAO_APP_SECRET=
